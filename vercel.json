{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/og-image.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/og-image.jpg", "destination": "/api/og-image.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
